classDiagram
    direction LR
    class USER {
        UUID UserID PK
        String FirstName
        String LastName
        String Email
    }
    class CUSTOMER {
        UUID CustomerID PK
        String FirstName
        String LastName
        String Email
        String Phone
    }
    class LEAD {
        UUID LeadID PK
        UUID CustomerID FK
        UUID AssignedTo FK
        String Source
        String Topic
        String Message
        String Status
        DateTime Timestamp
    }
    class AUDIT {
        UUID AuditID PK
        UUID LeadID FK
        String Action
        UUID ActorID FK
        String Comment
        DateTime Timestamp
    }
    CUSTOMER "1" --> "*" LEAD : has
    USER "1" --> "*" LEAD : assigned to
    LEAD "1" --> "*" AUDIT : tracks history in
    USER "1" --> "*" AUDIT : performs
